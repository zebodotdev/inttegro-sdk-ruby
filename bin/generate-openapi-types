    "OrderPaymentMethodBankAccount" => "PaymentMethodSnapshotBankAccount",
    "OrderPaymentMethodBankAccountGhanaBankAccount" => "PaymentMethodSnapshotGhanaBankAccount",
    "OrderPaymentMethodCard" => "PaymentMethodSnapshotCard",
    "OrderPaymentMethodMobileMoney" => "PaymentMethodSnapshotMobileMoney",
    "OrderPaymentMethodOwner" => "PaymentMethodSnapshotOwner",
    "OrderPaymentPayoutConfiguration" => "PaymentPayoutConfiguration",
    "OrderPaymentPayoutConfigurationDestination" => "PaymentPayoutConfigurationDestination",
    "PaymentResponse" => "PaymentResult",
    "PricePageResponsePage" => "PricePage",
    "RenderMessageTemplatePreviewResponse" => "MessageTemplatePreview",
    "SecretKeyUsageResponse" => "SecretKeyUsage",
    "UpdateApplicationResponseApp" => "UpdatedApplication",
    "UploadRequestObject" => "UploadRequest",
    "UploadRequestValidationErrorResponse" => "UploadRequestValidationFailure",
    "UploadRequestValidationErrorResponseError" => "UploadRequestValidationIssue",
    "UploadRequestWithAttemptObject" => "UploadRequestDetails",
    "VerifyOTPResponse" => "OTPVerification",
    "OrderResponse" => "OrderEnvelope",
    "FinalizeOrderResponse" => "FinalizeOrderEnvelope",
    "CompleteOrderResponse" => "CompleteOrderEnvelope",
    "OrderDocumentDeliveryResponse" => "OrderDocumentDeliveryResult",
    "PageOrdersResponse" => "PageOrdersEnvelope",
    "PageOrdersEnvelopePage" => "OrderPage"
  }.freeze
  HTTP_METHODS = %w[get post put patch delete].freeze
  SUCCESS_STATUS = /\A2\d\d\z/
  PREFERRED_ENUM_NAMES = {
    ["parent", "child"] => "AppManagementRole",
    ["child", "parent"] => "AppCredentialOwner",
    ["placement"] => "AppRelationshipKind",
    ["active", "inactive", "suspended", "revoked"] => "AppRelationshipStatus",
    ["bearer"] => "SecretKeyTokenType",
    ["active", "revoked", "expired"] => "SecretKeyStatus",
    ["succeeded", "failed"] => "SecretKeyAuthResult",
    ["uploading", "processing", "available", "failed", "deleted"] => "FileStatus",
    ["attachment", "inline"] => "FileDisposition",
    ["stream", "redirect"] => "FileContentsDeliveryMode",
    ["pending", "passed", "failed", "skipped"] => "FileScanStatus",
    ["direct", "upload_request", "service"] => "FileSourceType",
    ["identity", "br"] => "FileStorageEncoding",
    ["active", "revoked", "expired", "disabled"] => "FileLinkStatus",
    ["public"] => "FileLinkKind",
    ["redirect", "download", "inline"] => "FileLinkDeliveryMode",
    ["pending", "uploading", "fulfilled", "expired", "canceled", "failed"] => "UploadRequestStatus",
    ["approved", "rejected"] => "UploadReviewDecision",
    ["automatic", "manual"] => "UploadReviewType",
    ["confirm_payment", "execute", "redirect", "authorize", "none"] => "PaymentNextActionType",
    ["sms", "email", "push"] => "PaymentConfirmationChannel",
    ["mobile_money", "bank_account", "card", "motito"] => "PaymentMethodType",
    ["airtel", "mtn", "telecel", "vodafone"] => "MobileMoneyNetwork",
    ["physical", "digital", "service", "voucher", "custom", "cause"] => "ProductType",
    ["delivery", "download", "render", "service", "stream"] => "ProductShipmentType",
    ["delivery", "download", "render", "stream"] => "ProductShipmentInputType",
    ["product", "fee", "shipping"] => "LineItemType",
    ["active", "expired", "inactive", "used"] => "PurchaseIntentStatus",
    ["expired_viewed", "order_created", "payment_failed", "payment_started", "viewed"] => "PurchaseIntentActivityType",
    ["wallet", "bank_account", "dosh_account"] => "FinancialAccountType",
    ["ghana_bank_account"] => "BankAccountType",
    ["draft", "published", "archived"] => "MessageTemplateStatus",
    ["string", "number", "integer", "boolean", "url", "email", "phone", "date", "datetime", "array"] => "MessageTemplateVariableType",
    ["string", "number", "integer", "boolean", "url", "email", "phone", "date", "datetime"] => "MessageTemplateVariableItemType",
    ["allowed", "rejected", "quarantined"] => "ContentSafetyStatus",
    ["invoice", "receipt"] => "OrderDocumentKind",
    ["email", "sms"] => "DeliveryChannel",
    ["preparing", "requires_payment", "completed", "canceled", "expired"] => "CheckoutOrderStatus",
    ["preparing", "requires_payment", "paid", "completed", "canceled", "expired", "unknown"] => "OrderStatus",
    ["initiated", "requires_action", "overdue", "executed", "paid", "canceled", "expired", "failed", "unknown"] => "PaymentStatus",
    ["initiated", "executed", "succeeded", "canceled", "expired", "failed", "unknown"] => "PaymentAttemptStatus",
    ["requires_action", "processing", "succeeded", "failed", "cancelled"] => "CheckoutPaymentStatus",
    ["pending", "requires_confirmation", "processing", "succeeded", "failed"] => "PaymentResultStatus",
    ["purchase_intent"] => "OrderCreatedFromResourceType",
    ["requested_by_customer", "duplicate", "fraudulent", "order_canceled", "item_returned", "item_damaged", "item_not_received", "item_not_as_described", "custom"] => "RefundReason",
    ["canceled", "failed", "pending", "processing", "succeeded"] => "RefundStatus",
    ["payment", "refund"] => "BalanceTransactionType",
    ["initialized", "scheduled", "processing", "executing", "succeeded", "invalid", "canceled"] => "PayoutStatus",
    ["phone", "email"] => "ChimeRecipientType",
    ["gmail_view_action", "schema_org_order", "schema_org_invoice"] => "ChimeEmailSchemaKind",
    ["numeric", "alpha", "alphanumeric"] => "OTPAlphabetType",
    ["canceled", "expired", "pending", "pending_delivery", "pending_verification", "verified"] => "OTPStatus",
    ["delivered", "failed", "submitted"] => "OTPTransmissionStatus",
    ["fail", "pass"] => "OTPVerificationVerdict"
  }.freeze

  Node = Struct.new(:name, :schema, :origin, keyword_init: true)
  Operation = Struct.new(:path, :operation_id, :request_type, :response_type, :binary, keyword_init: true)
  Location = Struct.new(:package, :directory, :local_name, :class_package, keyword_init: true)
  EnumMetadata = Struct.new(:schema, :origin, :candidate, keyword_init: true)

  def initialize(spec)
    @spec = spec
    @component_schemas = spec.fetch("components").fetch("schemas")
    @nodes = {}
    @schema_names = {}
    @used_names = {}
    @enum_names = {}
    @enums = {}
    @enum_metadata = {}
    @operations = []
    @model_locations = {}
    @enum_locations = {}

    @component_schemas.each do |name, schema|
      next if IGNORED_LEGACY_COMPONENT_SCHEMAS.include?(name)
      next if map_schema?(schema)

      reserve_name(name)
    end
    @component_schemas.each do |name, schema|
      next if IGNORED_LEGACY_COMPONENT_SCHEMAS.include?(name)
      next if map_schema?(schema)

      register_named_schema(name, schema, "components.schemas.#{name}")
    end
  end

  def generate
    collect_operations
    collect_nested_types
    assign_locations

    render_package_files.merge(
      "lib/inttegro/generated/enums.rb" => render_enum_manifest,
      "lib/inttegro/generated/models.rb" => render_model_manifest,
      "lib/inttegro/generated/operations.rb" => render_operations
    )
  end

  private

  def assign_locations
    model_names = @nodes.values.reject { |node| enum_backed_node?(node) }.map(&:name)
    entries = model_names.map { |name| [:model, name] } + @enums.keys.map { |name| [:enum, name] }
    proposed = entries.to_h do |kind, name|
      package = package_for_name(name)
      [[kind, name], [package, local_name_for(name, package)]]
    end

    collisions = proposed.group_by { |_, (package, local_name)| [package, local_name] }
      .select { |_, values| values.length > 1 }
      .keys

    entries.each do |kind, name|
      package, local_name = proposed.fetch([kind, name])
      local_name = name if collisions.include?([package, local_name])
      definition = PACKAGE_DEFINITIONS.fetch(package)
      location = Location.new(
        package: package,
        directory: definition.fetch(:directory),
        local_name: local_name,
        class_package: CLASS_PACKAGES.include?(package)
      )
      (kind == :model ? @model_locations : @enum_locations)[name] = location
    end

    duplicate_constants = (@model_locations.to_a.map { |name, location| [qualified_name(name, location), [:model, name]] } +
      @enum_locations.to_a.map { |name, location| [qualified_name(name, location), [:enum, name]] })
      .group_by(&:first)
      .select { |_, values| values.length > 1 }
    return if duplicate_constants.empty?

    details = duplicate_constants.map do |constant, values|
      "#{constant}: #{values.map { |_, (_, name)| name }.join(', ')}"
    end
    raise "generated type namespace collisions: #{details.join('; ')}"
  end

  def package_for_name(name)
    return "Payment" if name.start_with?("PaymentMethodSnapshot")
    return "Money" if %w[Amount AmountParams Currency].include?(name)

    matches = PACKAGE_DEFINITIONS.filter_map do |package, definition|
      definition.fetch(:tokens).filter_map do |token|
        index = name.index(token)
        [index, -token.length, package] if index
      end
    end.flatten(1)
    matches.min&.last || "Shared"
  end

  def local_name_for(name, package)
    return name if name == package
    return "PaymentMethod" if package == "Payment" && name == "PaymentMethodSnapshot"

    tokens = PACKAGE_DEFINITIONS.fetch(package).fetch(:tokens)
    token = tokens.filter_map do |candidate|
      index = name.index(candidate)
      [index, -candidate.length, candidate] if index
    end.min&.last
    return name unless token

    local_name = name.sub(/#{Regexp.escape(token)}s?/, "")
    local_name.empty? ? name : local_name
  end

  def qualified_name(name, location)
    if location.class_package && name == location.package
      "Inttegro::#{location.package}"
    else
      "Inttegro::#{location.package}::#{location.local_name}"
    end
  end

  def model_reference(name)
    location = @model_locations[name]
    return qualified_name(name, location) if location
    return enum_reference(name) if @enum_locations.key?(name)

    "Inttegro::#{name}"
  end

  def enum_reference(name)
    location = @enum_locations[name]
    location ? qualified_name(name, location) : "Inttegro::#{name}"
  end

  def enum_backed_node?(node)
    node.schema.is_a?(Hash) && node.schema["type"] == "string" &&
      @enums[node.name] == node.schema["enum"]
  end

  def relocate_expression(expression)
    expression.gsub(/Inttegro::([A-Za-z0-9_]+)/) do
      name = Regexp.last_match(1)
      if @model_locations.key?(name)
        model_reference(name)
      elsif @enum_locations.key?(name)
        enum_reference(name)
      else
        Regexp.last_match(0)
      end
    end
  end

  def collect_operations
    @spec.fetch("paths").each do |path, path_item|
      method = HTTP_METHODS.find { |candidate| path_item.key?(candidate) }
      next unless method

      operation = path_item.fetch(method)
      operation_id = operation.fetch("operationId")
      request_schema = operation.dig("requestBody", "content", "application/json", "schema")
      request_type = request_schema && type_expression(
        request_schema,
        "#{constantize(operation_id)}Request",
        "paths.#{path}.#{method}.request"
      )

      response = operation.fetch("responses").find { |status, _| SUCCESS_STATUS.match?(status.to_s) }&.last
      content = response&.fetch("content", {}) || {}
      response_schema = content.dig("application/json", "schema")
      binary = content.dig("application/octet-stream", "schema", "format") == "binary"
      response_type = response_schema && type_expression(
        response_schema,
        "#{constantize(operation_id)}Response",
        "paths.#{path}.#{method}.response"
      )

      if response_type && !struct_type?(response_schema)
        raise "successful JSON response for #{path} must be an object schema, got #{response_type}"
      end

      @operations << Operation.new(
        path: path,
        operation_id: operation_id,
        request_type: request_type,
        response_type: response_type,
        binary: binary
      )
    end
  end

  def collect_nested_types
    processed = {}
    loop do
      pending = @nodes.values.reject { |node| processed[node.name] }
      break if pending.empty?

      pending.each do |node|
        processed[node.name] = true
        if object_schema?(node.schema)
          properties_for(node.schema).each do |property, schema|
            type_expression(schema, "#{node.name}#{constantize(property)}", "#{node.origin}.#{property}")
          end
        else
          type_expression(node.schema, node.name, node.origin)
        end
      end
    end
  end

  def register_named_schema(name, schema, origin)
    ruby_name = constantize(name)
    existing = @nodes[ruby_name]
    if existing && existing.schema != schema
      raise "schema name collision for #{ruby_name}: #{existing.origin} and #{origin}"
    end

    @nodes[ruby_name] ||= Node.new(name: ruby_name, schema: schema, origin: origin)
    @schema_names[schema.object_id] = ruby_name
    ruby_name
  end

  def register_inline_schema(candidate, schema, origin)
    existing = @schema_names[schema.object_id]
    return existing if existing

    name = unique_name(candidate)
    @nodes[name] = Node.new(name: name, schema: schema, origin: origin)
    @schema_names[schema.object_id] = name
    name
  end

  def reserve_name(name)
    @used_names[constantize(name)] = true
  end

  def unique_name(candidate)
    base = constantize(candidate)
    name = base
    index = 2
    name = "#{base}Inline" if @used_names[name] || @nodes.key?(name)
    while @used_names[name] || @nodes.key?(name)
      name = "#{base}#{index}"
      index += 1
    end
    @used_names[name] = true
    name
  end

  def type_expression(schema, candidate, origin, ignore_nullable: false)
    return "Object" unless schema.is_a?(Hash)

    if schema["$ref"]
      referenced = dereference(schema)
      return type_expression(referenced, candidate, origin) if map_schema?(referenced)

      return model_reference(constantize(schema.fetch("$ref").split("/").last))
    end

    if schema["nullable"] && !ignore_nullable
      inner = type_expression(schema, candidate, origin, ignore_nullable: true)
      return "T.nilable(#{inner})"
    end

    if schema["enum"] && schema["type"] == "string"
      return enum_reference(enum_name(schema.fetch("enum"), candidate, schema, origin))
    end

    if object_schema?(schema)
      if properties_for(schema).empty? && schema["additionalProperties"]
        value_schema = schema["additionalProperties"]
        value_type = value_schema.is_a?(Hash) && !value_schema.empty? ?
          type_expression(value_schema, "#{candidate}Value", "#{origin}.additionalProperties") : "Object"
        return "T::Hash[String, #{value_type}]"
      end

      name = @schema_names[schema.object_id] || register_inline_schema(candidate, schema, origin)
      return model_reference(name)
    end

    variants = schema["oneOf"] || schema["anyOf"]
    if variants
      types = variants.each_with_index.map do |variant, index|
        type_expression(variant, "#{candidate}Variant#{index + 1}", "#{origin}.variant#{index + 1}")
      end.uniq
      return types.first if types.one?

      return "T.any(#{types.join(", ")})"
    end

    case schema["type"]
    when "array"
      "T::Array[#{type_expression(schema.fetch("items", {}), "#{candidate}Item", "#{origin}.items")}]"
    when "boolean"
      "T::Boolean"
    when "integer"
      "Integer"
    when "number"
      "T.any(Integer, Float)"
    when "string"
      schema["format"] == "date-time" ? "Time" : "String"
    when nil
      all_of = schema["allOf"]
      return type_expression(all_of.first, candidate, origin) if all_of&.one?

      "Object"
    else
      "Object"
    end
  end

  def object_schema?(schema)
    return false unless schema.is_a?(Hash)
    return false if schema["$ref"]
    return true if schema["type"] == "object" || schema.key?("properties")

    schema["allOf"]&.any? { |part| object_schema?(dereference(part)) } || false
  end

  def map_schema?(schema)
    object_schema?(schema) && properties_for(schema).empty? && schema["additionalProperties"]
  end

  def struct_type?(schema)
    return struct_type?(dereference(schema)) if schema.is_a?(Hash) && schema["$ref"]

    object_schema?(schema) && !(properties_for(schema).empty? && schema["additionalProperties"])
  end

  def dereference(schema)
    return schema unless schema.is_a?(Hash) && schema["$ref"]

    @component_schemas.fetch(schema.fetch("$ref").split("/").last)
  end

  def properties_for(schema, seen = {})
    schema = dereference(schema)
    return {} unless schema.is_a?(Hash)
    return {} if seen[schema.object_id]

    seen = seen.merge(schema.object_id => true)
    properties = {}
    schema.fetch("allOf", []).each do |part|
      properties.merge!(properties_for(part, seen)) if part.is_a?(Hash)
    end
    properties.merge!(schema.fetch("properties", {}))
    properties
  end

  def required_for(schema, seen = {})
    schema = dereference(schema)
    return [] unless schema.is_a?(Hash)
    return [] if seen[schema.object_id]

    seen = seen.merge(schema.object_id => true)
    required = schema.fetch("required", []).dup
    schema.fetch("allOf", []).each do |part|
      required.concat(required_for(part, seen)) if part.is_a?(Hash)
    end
    required.uniq
  end

  def enum_name(values, candidate, schema, origin)
    signature = enum_signature(values)
    preferred = preferred_enum_name(values, candidate)
    key = [signature, preferred || constantize(candidate)]
    if @enum_names.key?(key)
      name = @enum_names.fetch(key)
      remember_enum_metadata(name, schema, origin, candidate)
      return name
    end

    name = unique_enum_name(preferred || candidate)
    @enum_names[key] = name
    @enums[name] = values
    remember_enum_metadata(name, schema, origin, candidate)
    name
  end

  def remember_enum_metadata(name, schema, origin, candidate)
    current = @enum_metadata[name]
    return if current && schema_description(current.schema)

    @enum_metadata[name] = EnumMetadata.new(schema: schema, origin: origin, candidate: candidate)
  end

  def preferred_enum_name(values, candidate)
    if values == ["sms", "email"]
      return candidate.include?("MessageTemplate") ? "MessageTemplateChannel" : "ChimeTransport"
    end
    if values == ["mobile_money"]
      return "WalletType" if candidate.include?("Wallet")

      return nil
    end

    PREFERRED_ENUM_NAMES[values]
  end

  def unique_enum_name(candidate)
    base = constantize(candidate)
    name = base
    index = 2
    while @enums.key?(name)
      name = "#{base}#{index}"
      index += 1
    end
    name
  end

  def enum_signature(values)
    values.map { |value| "#{value.class}:#{value}" }.join("\u0000")
  end

  def constantize(value)
    text = value.to_s
    return MODEL_NAME_OVERRIDES.fetch(text) if MODEL_NAME_OVERRIDES.key?(text)
    return text if text.match?(/\A[A-Z][A-Za-z0-9]*\z/)

    text = text
      .gsub(/([a-z\d])([A-Z])/, '\\1_\\2')
      .gsub(/[^A-Za-z0-9]+/, "_")
      .split("_")
      .reject(&:empty?)
      .map { |part| part.match?(/\A[A-Z\d]+\z/) ? part : part.capitalize }
      .join
    text = "Value#{text}" if text.match?(/\A\d/)
    text.empty? ? "Value" : text
  end

  def enum_constant(value)
    name = value.to_s.gsub(/[^A-Za-z0-9]+/, "_").upcase
    name = "VALUE_#{name}" if name.match?(/\A\d/)
    name.empty? ? "VALUE" : name
  end

  def schema_description(schema, seen = {})
    return unless schema.is_a?(Hash)
    return if seen[schema.object_id]

    seen = seen.merge(schema.object_id => true)
    direct = schema["description"] || schema["title"]
    return normalize_doc_text(direct) unless direct.to_s.strip.empty?

    if schema["$ref"]
      referenced = dereference(schema)
      return schema_description(referenced, seen)
    end

    schema.fetch("allOf", []).each do |part|
      description = schema_description(part, seen)
      return description if description
    end
    nil
  end

  def normalize_doc_text(text)
    text.to_s.lines.map(&:strip).reject(&:empty?).join(" ").gsub(/\s+/, " ").strip
  end

  def humanize_constant(name)
    name
      .gsub(/([A-Z\d]+)([A-Z][a-z])/, '\\1 \\2')
      .gsub(/([a-z\d])([A-Z])/, '\\1 \\2')
      .downcase
  end

  def wrapped_doc_lines(text, width: 92)
    words = normalize_doc_text(text).split
    return [] if words.empty?

    words.each_with_object([]) do |word, lines|
      if lines.empty? || lines.last.length + word.length + 1 > width
        lines << word.dup
      else
        lines[-1] << " #{word}"
      end
    end
  end

  def render_doc_comment(lines)
    lines.flatten.compact.map { |line| line.empty? ? "#" : "# #{line}" }.join("\n")
  end

  def yard_type(expression)
    if expression.start_with?("T.nilable(") && expression.end_with?(")")
      return "#{yard_type(expression[10...-1])}, nil"
    end
    if expression.start_with?("T::Array[") && expression.end_with?("]")
      return "Array<#{yard_type(expression[9...-1])}>"
    end
    if expression.start_with?("T::Hash[") && expression.end_with?("]")
      key, value = split_type_arguments(expression[8...-1])
      return "Hash{#{yard_type(key)} => #{yard_type(value)}}"
    end
    if expression.start_with?("T.any(") && expression.end_with?(")")
      return split_type_arguments(expression[6...-1]).map { |type| yard_type(type) }.join(", ")
    end

    expression == "T::Boolean" ? "Boolean" : expression
  end

  def split_type_arguments(expression)
    arguments = []
    depth = 0
    start = 0
    expression.each_char.with_index do |character, index|
      depth += 1 if "([".include?(character)
      depth -= 1 if ")]".include?(character)
      next unless character == "," && depth.zero?

      arguments << expression[start...index].strip
      start = index + 1
    end
    arguments << expression[start..].strip
    arguments
  end

  def model_description(node, location)
    schema_description(node.schema) ||
      "Typed representation of the #{humanize_constant(location.local_name)} object in the Inttegro API."
  end

  def property_description(property, schema)
    schema_description(schema) || "Value of the `#{property}` field in the Inttegro API payload."
  end

  def model_documentation(node, location, properties)
    lines = wrapped_doc_lines(model_description(node, location))
    lines.concat([
      "",
      "This generated model is immutable. Construct it with `.new`, or decode a string-keyed API",
      "payload with `.from_hash`. `#serialize` produces a string-keyed hash using the original wire",
      "field names and serialized enum values.",
      "",
      "@api public"
    ])
    properties.each do |property|
      requirement = if property.fetch(:required)
        "Required in the API payload."
      else
        "Optional in the API payload; omitted values default to `nil`."
      end
      lines.concat([
        "",
        "@!attribute [r] #{property.fetch(:ruby_name)}",
        *wrapped_doc_lines(property.fetch(:description)).map { |line| "  #{line}" },
        "",
        "  #{requirement} Wire name: `#{property.fetch(:wire_name)}`.",
        "  @return [#{yard_type(property.fetch(:type))}]"
      ])
    end
    render_doc_comment(lines)
  end

  def enum_description(name, location)
    metadata = @enum_metadata[name]
    schema_description(metadata&.schema) ||
      "String-backed values accepted by the Inttegro API for #{qualified_name(name, location)}."
  end

  def enum_value_description(metadata, value, index)
    descriptions = metadata&.schema&.[]("x-enum-descriptions") || metadata&.schema&.[]("x-enumDescriptions")
    description = if descriptions.is_a?(Array)
      descriptions[index]
    elsif descriptions.is_a?(Hash)
      descriptions[value]
    end
    normalize_doc_text(description) unless description.to_s.strip.empty?
  end

  def dependency_names(node)
    references = node_type_expressions(node).flat_map do |expression|
      expression.scan(/Inttegro(?:::[A-Z][A-Za-z0-9_]*)+/)
    end
    locations_by_constant = @model_locations.to_h do |name, location|
      [qualified_name(name, location), name]
    end
    references.filter_map { |reference| locations_by_constant[reference] }
      .reject { |name| name == node.name }
      .uniq
  end

  def node_type_expressions(node)
    expressions = []
    if object_schema?(node.schema)
      properties_for(node.schema).each do |property, schema|
        expressions << type_expression(schema, "#{node.name}#{constantize(property)}", "#{node.origin}.#{property}")
      end
    else
      expressions << type_expression(node.schema, node.name, node.origin)
    end
    expressions
  end

  def dependency_require_paths(node, location)
    references = node_type_expressions(node).flat_map do |expression|
      expression.scan(/Inttegro(?:::[A-Z][A-Za-z0-9_]*)+/)
    end.uniq
    locations_by_constant = {}
    @model_locations.each do |name, dependency_location|
      locations_by_constant[qualified_name(name, dependency_location)] = [name, dependency_location]
    end
    @enum_locations.each do |name, dependency_location|
      locations_by_constant[qualified_name(name, dependency_location)] = [name, dependency_location]
    end

    current_constant = model_reference(node.name)
    references.filter_map do |reference|
      next if reference == current_constant

      name, dependency_location = locations_by_constant[reference]
      next unless dependency_location

      basename = snake_case(dependency_location.local_name)
      dependency_location.directory == location.directory ? basename : "../#{dependency_location.directory}/#{basename}"
    end.uniq.sort
  end

  def ordered_nodes
    output = []
    visiting = {}
    visited = {}
    visit = lambda do |node|
      return if visited[node.name]
      raise "cyclic OpenAPI schema dependency at #{node.name}" if visiting[node.name]

      visiting[node.name] = true
      dependency_names(node).each do |dependency|
        visit.call(@nodes.fetch(dependency)) if @nodes.key?(dependency)
      end
      visiting.delete(node.name)
      visited[node.name] = true
      output << node
    end
    @nodes.values.sort_by(&:name).each { |node| visit.call(node) }
    output
  end

  def render_package_files
    files = {}
    used_packages = (@model_locations.values + @enum_locations.values).map(&:package).uniq.sort
    used_packages.each do |package|
      definition = PACKAGE_DEFINITIONS.fetch(package)
      files["lib/inttegro/#{definition.fetch(:directory)}/base.rb"] = render_package_base(package)
    end

    @enums.sort_by { |name, _| enum_reference(name) }.each do |name, values|
      location = @enum_locations.fetch(name)
      path = "lib/inttegro/#{location.directory}/#{snake_case(location.local_name)}.rb"
      files[path] = render_enum(name, values, location)
    end

    ordered_nodes.each do |node|
      next if enum_backed_node?(node)

      location = @model_locations.fetch(node.name)
      path = "lib/inttegro/#{location.directory}/#{snake_case(location.local_name)}.rb"
      raise "generated file collision at #{path}" if files.key?(path)

      files[path] = render_model(node, location)
    end
    files
  end

  def render_package_base(package)
    location = (@model_locations.values + @enum_locations.values).find { |candidate| candidate.package == package }
    declaration = location.class_package ? "class #{package} < T::Struct" : "module #{package}"
    namespace_documentation = if location.class_package
      nil
    else
      render_doc_comment([
        "Namespace for generated #{humanize_constant(package)} models and enums.",
        "",
        "Each public type in this namespace is defined in its own file and follows the field names",
        "and wire values declared by the Inttegro OpenAPI contract.",
        "",
        "@api public"
      ])
    end
    lines = [generated_header.rstrip, "", "require \"sorbet-runtime\"", "", "module Inttegro"]
    if namespace_documentation
      lines.concat(namespace_documentation.lines(chomp: true).map { |line| line.empty? ? "  #" : "  #{line}" })
    end
    lines.concat(["  #{declaration}", "  end", "end", ""])
    lines.join("\n")
  end

  def render_enum(name, values, location)
    metadata = @enum_metadata[name]
    enum_docs = render_doc_comment([
      *wrapped_doc_lines(enum_description(name, location)),
      "",
      "Use the constants below when constructing a request. `#serialize` returns the documented",
      "string wire value received from or sent to the API.",
      "",
      "@api public"
    ])
    definition = [
      enum_docs,
      "class #{location.local_name} < T::Enum",
      "  enums do",
      *values.each_with_index.flat_map do |value, index|
        value_description = enum_value_description(metadata, value, index)
        [
          *wrapped_doc_lines(value_description).map { |line| "    # #{line}" },
          "    # Serialized wire value: `#{value}`.",
          "    # @return [#{qualified_name(name, location)}]",
          "    #{enum_constant(value)} = new(#{value.inspect})"
        ]
      end,
      "  end",
      "end"
    ].join("\n")
    render_in_package(location, definition)
  end

  def render_model(node, location)
    definition = if object_schema?(node.schema)
      required = required_for(node.schema)
      properties = properties_for(node.schema).map do |property, schema|
        type = type_expression(schema, "#{node.name}#{constantize(property)}", "#{node.origin}.#{property}")
        unless required.include?(property) || type.start_with?("T.nilable(")
          type = "T.nilable(#{type})"
        end
        ruby_property = serialized_property_name(property)
        options = []
        options << "default: nil" unless required.include?(property)
        options << "name: #{property.inspect}" if ruby_property != property
        {
          definition: "const :#{ruby_property}, #{type}#{options.empty? ? '' : ", #{options.join(', ')}"}",
          description: property_description(property, schema),
          required: required.include?(property),
          ruby_name: ruby_property,
          type: type,
          wire_name: property
        }
      end
      documentation = model_documentation(node, location, properties)
      props = properties.map { |property| property.fetch(:definition) }
      body = props.empty? ? "# This object intentionally has no fields." : props.join("\n")
      if location.class_package && node.name == location.package
        return render_in_package(
          location,
          body,
          package_documentation: documentation,
          dependency_paths: dependency_require_paths(node, location)
        )
      else
        nested_body = body.lines(chomp: true).map { |line| "  #{line}" }.join("\n")
        [
          documentation,
          "class #{location.local_name} < T::Struct",
          nested_body,
          "end"
        ].join("\n")
      end
    else
      expression = type_expression(node.schema, node.name, node.origin)
      return generated_header + "# #{model_reference(node.name)} is represented by another generated type.\n" if expression == model_reference(node.name)

      documentation = render_doc_comment([
        *wrapped_doc_lines(model_description(node, location)),
        "",
        "@api public",
        "@return [#{yard_type(expression)}]"
      ])
      "#{documentation}\n#{location.local_name} = T.type_alias { #{expression} }"
    end
    render_in_package(location, definition, dependency_paths: dependency_require_paths(node, location))
  end

  def render_in_package(location, definition, package_documentation: nil, dependency_paths: [])
    package_declaration = location.class_package ? "class #{location.package}" : "module #{location.package}"
    dependency_requires = dependency_paths.map { |path| "require_relative #{path.inspect}" }
    require_lines = (["require_relative \"base\""] + dependency_requires).join("\n")
    lines = [generated_header.rstrip, "", require_lines, "", "module Inttegro"]
    if package_documentation
      lines.concat(package_documentation.lines(chomp: true).map { |line| line.empty? ? "  #" : "  #{line}" })
    end
    lines << "  #{package_declaration}"
    lines.concat(definition.lines(chomp: true).map { |line| line.empty? ? "" : "    #{line}" })
    lines.concat(["  end", "end", ""])
    lines.join("\n")
  end

  def render_enum_manifest
    paths = @enum_locations.map do |name, location|
      [enum_reference(name), "../#{location.directory}/#{snake_case(location.local_name)}"]
    end.sort.map { |_, path| "require_relative #{path.inspect}" }
    render_manifest(paths)
  end

  def render_model_manifest
    paths = ordered_nodes.reject { |node| enum_backed_node?(node) }.map do |node|
      location = @model_locations.fetch(node.name)
      "require_relative \"../#{location.directory}/#{snake_case(location.local_name)}\""
    end
    render_manifest(["require_relative \"enums\""] + paths)
  end

  def render_manifest(require_lines)
    <<~RUBY
      #{generated_header.rstrip}

      #{require_lines.join("\n")}
    RUBY
  end

  def generated_header
    <<~RUBY
      # frozen_string_literal: true
      # typed: strict

      # Generated from openapi/commerce.yml by bin/generate-openapi-types. Do not edit.
    RUBY
  end

  def snake_case(name)
    name
      .gsub(/IDs\b/, "Ids")
      .gsub(/([A-Z\d]+)([A-Z][a-z])/, '\\1_\\2')
      .gsub(/([a-z\d])([A-Z])/, '\\1_\\2')
      .downcase
  end

  def serialized_property_name(property)
    case property
    when "display" then "display_data"
    when "format" then "format_value"
    else property
    end
  end

  def render_operations
    response_entries = @operations.filter_map do |operation|
      next unless operation.response_type

      "      #{operation.path.inspect} => #{relocate_expression(operation.response_type)}"
    end.join(",\n")
    request_entries = @operations.filter_map do |operation|
      next unless operation.request_type

      "      #{operation.path.inspect} => #{relocate_expression(operation.request_type).inspect}"
    end.join(",\n")
    operation_ids = @operations.map do |operation|
      "      #{operation.path.inspect} => #{operation.operation_id.inspect}"
    end.join(",\n")
    binary_paths = @operations.select(&:binary).map { |operation| operation.path.inspect }.join(", ")

    <<~RUBY
      # frozen_string_literal: true
      # typed: strict
      # Generated from openapi/commerce.yml by bin/generate-openapi-types. Do not edit.

      require "sorbet-runtime"
      require_relative "models"

      module Inttegro
        module Operations
          RESPONSE_MODELS = T.let({
      #{response_entries}
          }.freeze, T::Hash[String, T::Class[T::Struct]])

          REQUEST_TYPE_NAMES = T.let({
      #{request_entries}
          }.freeze, T::Hash[String, String])

          OPERATION_IDS = T.let({
      #{operation_ids}
          }.freeze, T::Hash[String, String])

          BINARY_PATHS = T.let([#{binary_paths}].freeze, T::Array[String])
        end
      end
    RUBY
  end
end

if $PROGRAM_NAME == __FILE__
  sdk_root = Pathname.new(__dir__).join("..").expand_path
  spec_path = Pathname.new(ENV.fetch("INTTEGRO_OPENAPI_SPEC", sdk_root.join("..", "..", "openapi", "commerce.yml").to_s))
  abort "OpenAPI spec not found at #{spec_path}" unless spec_path.file?

  spec = YAML.load_file(spec_path)
  generated = OpenAPITypeGenerator.new(spec).generate
  stale = []
  generated_marker = "# Generated from openapi/commerce.yml by bin/generate-openapi-types. Do not edit."
  existing_generated = Dir[sdk_root.join("lib", "inttegro", "**", "*.rb")].filter_map do |path|
    relative_path = Pathname.new(path).relative_path_from(sdk_root).to_s
    relative_path if File.foreach(path).first(4).any? { |line| line.chomp == generated_marker }
  end
  unexpected = existing_generated - generated.keys

  generated.each do |relative_path, content|
    target = sdk_root.join(relative_path)
    if ARGV == ["--check"]
      stale << relative_path unless target.file? && target.read == content
    else
      target.dirname.mkpath
      target.write(content)
      puts "wrote #{relative_path}"
    end
  end

  if ARGV == ["--check"]
    stale.concat(unexpected)
    unless stale.empty?
      warn "generated OpenAPI types are stale: #{stale.sort.join(', ')}; run bin/generate-openapi-types"
      exit 1
    end
    puts "generated OpenAPI types are up to date"
  elsif ARGV.empty?
    unexpected.sort.each do |relative_path|
      sdk_root.join(relative_path).delete
      puts "removed #{relative_path}"
    end
  else
    abort "usage: bin/generate-openapi-types [--check]"
  end
end
