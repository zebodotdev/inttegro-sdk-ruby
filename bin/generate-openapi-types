#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
require "yaml"

class OpenAPITypeGenerator
  IGNORED_LEGACY_COMPONENT_SCHEMAS = ["OrderCreateResponse"].freeze
  PACKAGE_DEFINITIONS = {
    "Application" => { directory: "app", tokens: %w[Application App] },
